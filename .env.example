# 沮诵 · 可选 API（当前版本不需要任何 key）
# 真实 key 写入 .env，不提交、不打印。
# 高德（中文地图/地理编码）
AMAP_WEB_KEY=
# ArcGIS（英文底图，可选）
ARCGIS_API_KEY=
# AGENT：OpenAI 兼容 LLM（默认 DeepSeek；密钥也可在应用设置页填写，写入用户库）
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 开发期回退：Rust 侧读取的 AGENT 环境变量（生产以设置页保存的配置为准）
JUSONG_AGENT_API_KEY=
JUSONG_AGENT_BASE_URL=https://api.deepseek.com
JUSONG_AGENT_MODEL=deepseek-chat
# 后续来源检索
SEARCH_PROVIDER=
SEARCH_API_KEY=
