{
  "name": "jusong",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:seed": "node scripts/sync-seed-resources.mjs",
    "build:app": "pnpm build:seed && pnpm build && node scripts/build-seed-pack.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter @jusong/core typecheck",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version:show": "node scripts/version.mjs show",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "@jusong/core": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "rolldown": "^1.2.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
